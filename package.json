{
  "name": "synthetic-corbato",
  "version": "0.1.0",
  "description": "WYSIWYG LaTeX research-paper editor with live PDF preview and an MCP server for agents.",
  "main": "./out/main/index.js",
  "author": "synthetic-corbato",
  "scripts": {
    "format": "prettier --write .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "parse:debug": "node --import tsx scripts/parse-debug.mjs",
    "preview": "node --import tsx scripts/render-preview.mjs",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "fidelity": "node --import tsx scripts/fidelity.mjs",
    "check:zoom": "node scripts/check-zoom-anchor.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.4",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/language": "^6.10.6",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@retorquere/bibtex-parser": "^9.0.7",
    "@unified-latex/unified-latex-types": "^1.8.0",
    "@unified-latex/unified-latex-util-parse": "^1.8.0",
    "@unified-latex/unified-latex-util-print-raw": "^1.8.0",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "electron-store": "^11.0.2",
    "express": "^5.2.1",
    "immer": "^11.1.4",
    "katex": "^0.16.21",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "^5.4.296",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.4.1",
    "prosemirror-inputrules": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.0",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.39.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^2.1.9",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^2.1.9"
  }
}
